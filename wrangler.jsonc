{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hiro-knowledge",
  "main": "src/index.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": false },
  "d1_databases": [{ "binding": "DB", "database_name": "hiro-knowledge", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "vars": { "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUD": "", "OWNER_EMAIL": "" }
}
